{
  "expo": {
    "name": "PetChain",
    "slug": "petchain-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "petchain",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.petchain.mobile",
      "associatedDomains": [
        "applinks:petchain.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "app.petchain.mobile.refresh",
          "app.petchain.mobile.processing"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealth",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.petchain.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "petchain.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACTIVITY_RECOGNITION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "organization": "petchain",
          "project": "mobile-app"
        }
      ],
      [
        "expo-screen-capture",
        {
          "sensitiveScreens": [
            "MedicalRecords",
            "WalletSecrets",
            "EmergencyDetails"
          ],
          "publicScreens": [
            "QRVerification"
          ]
        }
      ],
      [
        "expo-background-fetch",
        {
          "minimumInterval": 900,
          "stopOnTerminate": false,
          "startOnBoot": true
        }
      ]
    ],
    "extra": {
      "APP_ENV": "development",
      "SENTRY_DSN": "",
      "backgroundRefresh": {
        "enabled": true,
        "taskIdentifier": "app.petchain.mobile.refresh",
        "processingTaskIdentifier": "app.petchain.mobile.processing",
        "minimumIntervalSeconds": 900,
        "requiresBackgroundModes": [
          "fetch",
          "processing"
        ],
        "requiresBackgroundAppRefresh": true,
        "degradeToForeground": true,
        "iosConfigurationChecklist": [
          "Enable the 'Background Modes' capability in Xcode for the app target.",
          "Check 'Background fetch' and 'Background processing' under Background Modes.",
          "Ensure the device setting Settings > General > Background App Refresh is ON for PetChain.",
          "Verify BGTaskSchedulerPermittedIdentifiers includes app.petchain.mobile.refresh and app.petchain.mobile.processing.",
          "Confirm UIBackgroundModes includes fetch and processing in Info.plist.",
          "Do not re-prompt for permission; surface registration status to support instead."
        ]
      },
      "snapshotProtection": {
        "enabled": true,
        "sensitiveScreens": [
          "MedicalRecords",
          "WalletSecrets",
          "EmergencyDetails"
        ],
        "publicScreens": [
          "QRVerification"
        ],
        "ios": {
          "strategy": "blur-overlay",
          "applyOn": [
            "focus",
            "background"
          ]
        },
        "android": {
          "strategy": "FLAG_SECURE",
          "applyOn": [
            "focus",
            "background"
          ]
        }
      },
      "deepLink": {
        "scheme": "petchain",
        "universalLinkHost": "petchain.app",
        "routes": [
          {
            "path": "/pets/:petId",
            "params": {
              "petId": "string"
            },
            "requiresAuth": true,
            "mutating": false
          },
          {
            "path": "/appointments/:appointmentId",
            "params": {
              "appointmentId": "string"
            },
            "requiresAuth": true,
            "mutating": false
          },
          {
            "path": "/invite/:token",
            "params": {
              "token": "string"
            },
            "requiresAuth": false,
            "mutating": false
          }
        ]
      },
      "dataSafety": {
        "dataCollected": [
          {
            "type": "Photos",
            "purposes": [
              "AppFunctionality"
            ],
            "shared": false,
            "optional": true
          },
          {
            "type": "PreciseLocation",
            "purposes": [
              "AppFunctionality"
            ],
            "shared": false,
            "optional": true
          },
          {
            "type": "HealthInfo",
            "purposes": [
              "AppFunctionality"
            ],
            "shared": false,
            "optional": true
          },
          {
            "type": "EmailAddress",
            "purposes": [
              "AppFunctionality"
            ],
            "shared": false,
            "optional": false
          },
          {
            "type": "UserID",
            "purposes": [
              "AppFunctionality",
              "Analytics"
            ],
            "shared": false,
            "optional": false
          }
        ],
        "dataShared": [],
        "securityPractices": {
          "dataEncryptedInTransit": true,
          "dataDeletionRequestSupported": true
        }
      }
    }
  }
}
